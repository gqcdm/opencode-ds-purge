{
  // 最干净的形态：不留任何自称，只留能力。
  // 适合把 opencode 当执行器用、不想它跟你聊人格的时候。
  // 代价是它会显得没主见——因为确实没有身份替它做判断。
  "preset": "all",

  // 身份槽位彻底留空，不补任何替换文本
  "identityReplacement": "",

  // 至少留一句「怎么干活」，否则它会漂
  "prepend": "直接给结果。不要在回复前后加铺垫、总结或自我说明。",

  "extraParts": ["^\\s*<env>[\\s\\S]*</env>\\s*$"],

  "verbose": false
}
