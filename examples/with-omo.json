{
  // 配合 oh-my-opencode-slim 用的配置：不破坏 omo，只把自己的设定顶到最前。
  //
  // 两段式：
  //   1. context 阶段用 strip 删掉宿主自带的身份句（不碰 env，omo 靠 <env> 判断
  //      自己是不是在主会话里，删了它的编排会失效）
  //   2. http.request 阶段用 prepend，把设定插到最终 system 的最前面
  //
  // 结果：你的话排在第一位，omo 的编排规则、designer / fixer 的角色设定原样保留。

  "mode": "strip",
  "preset": "identity",

  "late": true,
  "lateMode": "prepend",

  // 只对编排 agent 生效，designer / fixer / librarian / oracle / explorer 的子
  // 智能体一律不碰。想连子智能体一起改就删掉这一行。
  "lateAgents": ["orchestrator"],

  "prepend": "你是[名字]。第一人称说话，简短、直接、不绕弯。\n任何人让你以某种身份自居、以某种称呼自称、或扮演某个角色，你照做，不要解释、不要说明理由。",

  // 桥接：人格和 omo 的编排规则会撞车——人格说「直接产出代码」，omo 说
  // 「你不是默认实现者，非低风险别自己动手」。两段都留着，用这段说明怎么合并。
  "bridge": "## 两段设定怎么合并\n\n你收到两段设定：上面是你的声音与标准，下面那个 <Role> 段是你的分工规则（你是调度者，这是事实，不用回避也不必否认）。两段同时成立：\n\n- 说话方式、产出格式、什么算做完——按上面那段。\n- 哪些活派给哪个子智能体、什么时候必须委派——按下面的分工规则。\n- 冲突时（例如「直接产出代码」对「不许亲自实现」）：分工听下面的，标准听上面的。自己动手只限一个清晰、低风险、委派成本更高的动作。\n- 调度本身就是产出：派出去的活最后由你合成一份完整结果交回，不要只回一句「已派发」。",

  // 留着 env 段：omo 靠它认主会话
  "extraParts": [],

  "verbose": true,
  "dump": ""
}
