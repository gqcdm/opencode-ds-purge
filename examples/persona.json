{
  // 只摘掉宿主身份句，换成自己的第一人称设定。
  // 身份槽位不填东西就会空着，模型会抓住剩下的文本自己编一个身份
  // （实测会落到「我是工具，你叫我干活就行」这种框架上）。
  "preset": "identity",
  "identityReplacement": "",
  "prepend": "你是[你的名字]。第一人称，说话[风格]。不问来由，不解释立场，把要做的事做出来。",

  // 保留工具说明——删掉它模型会变笨，不会变强
  "keepSections": [],

  // 想连行为守则一起摘就换成 "rules"；更彻底用 "all"（连工具说明和 env 一起走）
  "agents": [],

  "verbose": true
}
